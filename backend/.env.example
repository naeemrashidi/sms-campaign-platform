TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Messaging Service used for SMS sends.
SMS_SERVICE_SID=

# WhatsApp sender. Set ONE of the two once a working WhatsApp sender exists:
# - WHATSAPP_SERVICE_SID: a Messaging Service with an approved WhatsApp sender attached.
# - WHATSAPP_FROM: a direct sender address, e.g. whatsapp:+14155238886 (Twilio Sandbox for testing).
WHATSAPP_SERVICE_SID=
WHATSAPP_FROM=

# Public URL of this deployed service, used so Twilio can call back with
# delivery/read status events. Example: https://sms-poc-t1gc.onrender.com
PUBLIC_BASE_URL=

PORT=4000
NODE_ENV=production
